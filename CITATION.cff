    given-names: Pascal
    email: steffens@stfs.tu-darmstadt.de
    affiliation: "Institute for Simulation of reactive Thermo-Fluid Systems (STFS), TU Darmstadt"
  - family-names: Berkel
    given-names: "Leon Loni"
    affiliation: "Institute for Simulation of reactive Thermo-Fluid Systems (STFS), TU Darmstadt"
  - family-names: Vahl
    given-names: Antje
    affiliation: "Institute for Simulation of reactive Thermo-Fluid Systems (STFS), TU Darmstadt"
  - family-names: Steinhausen
    given-names: Matthias
    affiliation: "Institute for Simulation of reactive Thermo-Fluid Systems (STFS), TU Darmstadt"
  - family-names: Nicolai
    given-names: Hendrik
    affiliation: "Department of Mechanical Engineering, McGill University"
  - family-names: Hasse
    given-names: Christian
    affiliation: "Institute for Simulation of reactive Thermo-Fluid Systems (STFS), TU Darmstadt"
keywords:
  - OpenFOAM
  - CFD
  - combustion
  - flamelet
  - tabulated chemistry
  - Lagrangian particles
  - coal combustion
  - biomass combustion
