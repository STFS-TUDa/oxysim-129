FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.06";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    wall
    {
        type            waveTransmissive;
        fieldInf        101325;
        lInf            0.5;
        inletOutlet     false;
        correctSupercritical false;
        value           uniform 101325;
        gamma           1.4;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 101325;
    }
    frontAndBack
    {
        type            empty;
    }
}


