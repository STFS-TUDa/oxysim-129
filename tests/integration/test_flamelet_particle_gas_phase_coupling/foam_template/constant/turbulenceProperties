FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType laminar;

RAS
{
    RASModel        kEpsilon;

    turbulence      on;

    printCoeffs     yes;
}
LES
{
    turbulence      on;
    LESModel        WALE;
    
    delta           cubeRootVol;

    cubeRootVolCoeffs
    {
        // Optional entries

        // Multiplier
        deltaCoeff      1;
    }

}

