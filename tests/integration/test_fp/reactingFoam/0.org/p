FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.org";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];


internalField   uniform 101325;

boundaryField 
{ 
    inlet
    {
        type    zeroGradient;
    }
    outlet
    {
        type    waveTransmissive;
        field p;
        psi thermo:psi;
        gamma 1.4;
        fieldInf 101325;
        lInf 0.025;
        value   uniform 101325;
    }
    frontAndBack
    {
        type    empty;
    }
} 


