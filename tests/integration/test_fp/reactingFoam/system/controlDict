FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         0.01;

deltaT          1e-6;

writeControl    adjustableRunTime;
writeInterval   1e-3;

purgeWrite      0;

writeFormat     ascii;
writePrecision  12;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;
adjustTimeStep  no;

libs            ();

functions
{
    writeReactionRates
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        objects         (rho RR.CO RR.CO2);
        writeControl    writeTime;
    }
}

