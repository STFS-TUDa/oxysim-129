FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      coalCloud1Properties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
soi              0.05;

solution
{
    active          true;
    transient       yes;
    coupled         false;
    cellValueSourceCorrection on;
    maxCo           0.3;

    sourceTerms
    {
        schemes
        {
            rho             semiImplicit 1;
            U               semiImplicit 1;
            Yi              semiImplicit 1;
            h               semiImplicit 1;
            radiation       semiImplicit 1;
        }
    }

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        thermo:mu       cell;
        T               cellPoint;
        cp              cellPoint;
        kappa           cell;
        p               cell;
        G               cell;
        mu              cell;
    }

    integrationSchemes
    {
        U               Euler;
        T               analytical;
    }
}

constantProperties
{
    rho0            1000;
    T0              300;
    particleModelType 1;
    subTimeSteps    50;

    Cp0             960;
    epsilon0        0.7;
    f0              0.5;
    TDevol          950;
    LDevol          0;
    hRetentionCoeff 1;
    constantVolume  false;
}

subModels
{
    particleForces
    {
    }

    injectionModels
    {

        model1
        {
            type            manualInjection;
            massTotal       1.309e-10;
	    //nParticle		1;
            parcelBasisType mass;
            SOI             0;
            positionsFile   "particlePositions";
            U0              (0 0 0);
                sizeDistribution
                {
                    type        fixedValue;
                    fixedValueDistribution
                    {
                        value   30e-06;
                    }
                }
        }
    }
    	

    

    dispersionModel none;

    patchInteractionModel standardWallInteraction;

    heatTransferModel RanzMarshall;

    compositionModel singleMixtureFraction;

    phaseChangeModel none;

    devolatilisationModel none;

    devolatilisationModelSTFS   none;

    stochasticCollisionModel none;

    surfaceReactionModel none;

    surfaceFilmModel none;

    heatCapacityModelSTFS none;

    radiation       off;
    

    patchInteractionModel standardWallInteraction;

    standardWallInteractionCoeffs
    {
        type            rebound;
        e               1;
        mu              0;
    }

    RanzMarshallCoeffs
    {
        BirdCorrection  true;
    }

    singleMixtureFractionCoeffs
    {
        phases
        (
            gas
            {
	    	O2 1;
            }
            liquid
            {
            }
            solid
            {
            }
        );
        YGasTot0        1;
        YLiquidTot0     0;
        YSolidTot0      0;
    }

}




